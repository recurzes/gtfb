{
  "manifest_version": 3,
  "name": "GTFB — Anti-Distraction Suite",
  "version": "1.0.0",
  "description": "Enforce scheduled anti-distraction blocking across distracting websites.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/blocked.html"],
      "matches": ["*://*/*"]
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "gtfb@local.dev",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "GTFB Anti-Distraction",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

